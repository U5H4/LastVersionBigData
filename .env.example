# Corporativo JUC — credenciales para servicios en la nube
# Trabaja asi: copia este archivo a .env y rellena los valores.
# .env NO se versiona; .env.example se versiona como plantilla.

# --- Supabase (PostgreSQL) ---
# Usa el Session pooler: aws-0-<region>.pooler.supabase.com
# El host directo (db.<proyecto>.supabase.co) solo resuelve por IPv6.
SUPABASE_HOST=
SUPABASE_PORT=5432
SUPABASE_DATABASE=postgres
SUPABASE_USER=postgres.<proyecto>
SUPABASE_PASSWORD=
PG_SSLMODE=require

# --- MongoDB Atlas ---
# mongodb+srv://<usuario>:<clave>@<cluster>.mongodb.net/?appName=<app>
MONGO_ATLAS_URI=
# Si prefieres usar MONGO_URI en su lugar, tambien funciona:
# MONGO_URI=mongodb+srv://<usuario>:<clave>@<cluster>.mongodb.net/?appName=<app>
MONGO_DB=Prueba1

# --- Google Sheets (opcional) ---
# Enlaces HTTPS de docs.google.com con permiso de lectura por enlace.
# Si se dejan vacíos, se usan los XLSX locales en data/raw/sheets/.
GOOGLE_SHEETS_SUCURSALES_URL=
GOOGLE_SHEETS_PROVEEDORES_URL=
GOOGLE_SHEETS_PROMOCIONES_URL=
GOOGLE_SHEETS_OBJETIVOS_URL=

# --- Forzar modo local (opcional) ---
# SIN_POSTGRES=1
# SIN_MONGO=1
# FORZAR_SQLITE=1
