digraph Normalizacion3FN {
  graph [label="Corporativo JUC  |  Esquema normalizado juc_3fn (PostgreSQL)",labelloc=t,fontsize=18,fontname="DejaVu Sans",pad=0.4,bgcolor="white",ranksep=0.9,nodesep=0.55, splines=polyline];
  node [shape=record,fontname="DejaVu Sans",fontsize=11,style="rounded,filled", fillcolor="#f5f7fb",color="#6f839e",penwidth=1.3];
  edge [color="#57718e",penwidth=1.3,arrowsize=.7];

  categorias [label="{categorias|PK id_categoria\lnombre (UNIQUE)\ldescripcion\l}"];
  dim_ciudades [label="{dim_ciudades|PK id_ciudad\lnombre (UNIQUE)\lregion\l}"];
  dim_sucursales [label="{dim_sucursales|PK id_sucursal\lnombre (UNIQUE)\lFK id_ciudad\lmetros_cuadrados\lfecha_apertura\l}"];
  clientes [label="{clientes|PK id_cliente\lnombre\lcorreo\ltelefono\lFK id_ciudad\lfecha_alta\lcanal_registro\les_premium\l}"];
  productos [label="{productos|PK id_producto\lnombre (UNIQUE)\lFK id_categoria\lprecio\lmargen_bruto\lid_proveedor\lactivo\lfecha_lanzamiento\l}"];
  pedidos [label="{pedidos|PK id_pedido\lFK id_cliente\lfecha_pedido\lcanal_venta\lFK id_sucursal\lestado\l}"];
  detalle_pedido [label="{detalle_pedido|PK id_detalle\lFK id_pedido\lFK id_producto\lcantidad\lprecio_unitario\ldescuento\l}"];
  pagos [label="{pagos|PK id_pago\lFK id_pedido\lmetodo\lmonto\lfecha_pago\lestado_pago\l}"];

  categorias -> productos [label="1:N"];
  dim_ciudades -> clientes [label="1:N"];
  dim_ciudades -> dim_sucursales [label="1:N"];
  clientes -> pedidos [label="1:N"];
  dim_sucursales -> pedidos [label="1:N"];
  pedidos -> detalle_pedido [label="1:N"];
  productos -> detalle_pedido [label="1:N"];
  pedidos -> pagos [label="1:N"];
}
